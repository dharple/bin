set -e

function banner()
{
	echo -------------------------------------
	echo "$1"
	echo -------------------------------------
	echo
}

# -------------------------------[ option parser ]------------------------------

function usage()
{
	cat << DONE

Usage:
	gitr <git-command>
	gitr composer <composer-command>
	gitr npm <npm-command>
	gitr symfony <symfony-command>

Flags:
	-a	Work on all trees [ignore skip-gitr]
	-f	Force; ignore errors
	-h	This message
	-v	Be verbose

DONE
}

if [ -n "$VERBOSE" ] ; then
	echo "Setting VERBOSE in the environment is no longer supported; use -v"
fi

VERBOSE=0
ALL=0

while getopts ":afhv" opt; do
	case "${opt}" in
		a)
			# all
			ALL=1
			;;

		h)
			# help
			usage
			exit 0
			;;

		f)
			# force
			set +e
			;;


		v)
			# verbose
			VERBOSE=1
			;;

		*)
			# invalid command

			echo "error: unknown argument" >&2
			usage
			exit 1
			;;
	esac
done

shift $((OPTIND -1))

if [ -z "$1" ] ; then
	echo "error: missing command" >&2
	usage
	exit 1
fi

# ---------------------------------[ main loop ]--------------------------------

SKIPFILE=.git/skip-gitr

BASE=$(pwd)
for GITDIR in $(find . -maxdepth 5 -type d -name .git -not -path '*/vendor/*' -not -path '*/.*/*' | sort) ; do
	REPODIR=$(dirname "$GITDIR")

	cd "$BASE"/"$REPODIR" || exit

	if [ "$1" = "skip" ] ; then
		banner "$REPODIR"

		case "$2" in
			disable)
				if [ -f "$SKIPFILE" ] ; then
					rm -f $SKIPFILE
					echo "gitr skip is now disabled"
				else
					echo "gitr skip is already disabled"
				fi
			;;

			enable)
				if [ ! -f "$SKIPFILE" ] ; then
					touch $SKIPFILE
					echo "gitr skip is now enabled"
				else
					echo "gitr skip is already enabled"
				fi

			;;

			status)
				if [ -f "$SKIPFILE" ] ; then
					if [ "$VERBOSE" -gt 0 ] ; then
						echo "gitr skip is enabled in this repo"
						echo -n "... "
					fi
					echo "this repo is ignored by gitr"
				else
					if [ "$VERBOSE" -gt 0 ] ; then
						echo "gitr skip is disabled in this repo"
					fi
				fi
			;;

			*)
				echo "usage:"
				echo "	gitr skip (disable|enable|status)"
			;;
		esac

		echo

		continue
	fi

	if [ -f "$SKIPFILE" -a "$ALL" -eq 0 ] ; then
		if [ "$VERBOSE" -gt 0 ] ; then
			banner "$REPODIR"
			echo "gitr disabled in this repo"
			echo
		fi

		continue
	fi

	banner "$REPODIR"

	if [ "$1" = "composer" -o "$1" = "symfony" ] ; then
		if [ -f composer.json ] ; then
			"$@"
		fi
	elif [ "$1" = "npm" ] ; then
		if [ -f package.json ] ; then
			"$@"
		fi
	else
		git "$@"
	fi

	echo
done
